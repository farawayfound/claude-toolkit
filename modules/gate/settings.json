{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"__HOOKS_DIR__/gate.mjs\"", "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "node \"__HOOKS_DIR__/gate.mjs\"", "timeout": 5 }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "node \"__HOOKS_DIR__/gate.mjs\"", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"__HOOKS_DIR__/gate.mjs\"", "timeout": 10 }] }
    ]
  }
}
