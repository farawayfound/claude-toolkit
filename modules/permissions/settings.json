    "ask": ["Bash(git push:*)", "Bash(gh pr create:*)", "Bash(gh pr merge:*)"],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git reset --hard:*)", "Bash(git clean:*)",
      "Bash(rm -rf:*)", "Bash(rm -fr:*)", "Bash(printenv:*)", "Bash(gh auth token:*)",
