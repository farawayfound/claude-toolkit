#!/usr/bin/env bash
# wt-conflicts  would any two issue branches conflict with each other, or with a moved base?
# Uses git merge-tree (git 2.38+): no checkout, no working-tree change. Checks committed work only.
# Base: the remote's default branch, else origin/main, else the main checkout's branch.
# Exit 0 all clean, 1 any conflict, 2 nothing to check or git failed.
main=$(git worktree list --porcelain | sed -n '1s/^worktree //p'); [ -n "$main" ] || exit 2
base=$(git -C "$main" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null \
  || { git -C "$main" rev-parse -q --verify origin/main >/dev/null && echo origin/main; } || git -C "$main" branch --show-current)
bs=(); while IFS= read -r b; do bs+=("$b"); done < <(git -C "$main" for-each-ref --format='%(refname:short)' refs/heads/fix refs/heads/feat 'refs/heads/worktree-*')
[ ${#bs[@]} -gt 0 ] || { echo "no fix/*, feat/* or worktree-* branches in $main" >&2; exit 2; }
status=0
for ((i = 0; i < ${#bs[@]}; i++)); do
  for other in "$base" "${bs[@]:i+1}"; do
    out=$(git -C "$main" merge-tree --write-tree --name-only "${bs[i]}" "$other")
    case $? in
      0) echo "ok        ${bs[i]} + $other" ;;
      1) status=1; echo "CONFLICT  ${bs[i]} + $other: $(printf '%s\n' "$out" | sed -n '2,/^$/p' | sed '/^$/d' | tr '\n' ' ')" ;;
      *) echo "merge-tree failed for ${bs[i]} + $other" >&2; exit 2 ;;
    esac
  done
done
exit $status
