{
  "env": { "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1" },
  "hooks": {
    "TaskCreated": [
      { "hooks": [{ "type": "command", "command": "node \"__HOOKS_DIR__/teams.mjs\"", "timeout": 5 }] }
    ],
    "TaskCompleted": [
      { "hooks": [{ "type": "command", "command": "node \"__HOOKS_DIR__/teams.mjs\"", "timeout": 5 }] }
    ],
    "TeammateIdle": [
      { "hooks": [{ "type": "command", "command": "node \"__HOOKS_DIR__/teams.mjs\"", "timeout": 5 }] }
    ]
  }
}
